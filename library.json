{
  "name": "oa3",
  "version": "0.2.0",
  "description": "Portable C++ OpenADR 3.1.0 library for microcontrollers and POSIX: the entity model, a VEN client, and later a small VTN. Depends on the C/C++ standard library and ArduinoJson; a port supplies HTTP, MQTT, mDNS and the clock.",
  "keywords": "openadr, openadr3, demand-response, energy, esp32",
  "repository": {
    "type": "git",
    "url": "https://github.com/grid-coordination/cpp-oa3.git"
  },
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "dependencies": [
    {
      "owner": "bblanchon",
      "name": "ArduinoJson",
      "version": "7.4.3"
    }
  ],
  "build": {
    "includeDir": "model/include",
    "srcDir": ".",
    "srcFilter": [
      "+<model/src/>",
      "+<client/src/>"
    ],
    "flags": [
      "-I client/include"
    ]
  }
}
